{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://polypore.dev/schemas/events.schema.json",
  "title": "AppEvent",
  "oneOf": [
    { "type": "object", "additionalProperties": false, "required": ["type", "event"], "properties": { "type": { "const": "history:event" }, "event": { "$ref": "types.schema.json#/definitions/HistoryEvent" } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "nodes", "edges"], "properties": { "type": { "const": "workflow:update" }, "nodes": { "type": "array", "items": { "$ref": "types.schema.json#/definitions/WorkflowNode" } }, "edges": { "type": "array", "items": { "$ref": "types.schema.json#/definitions/WorkflowEdge" } } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "run"], "properties": { "type": { "const": "verify:run-recorded" }, "run": { "$ref": "types.schema.json#/definitions/VerifyRun" } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "connected", "agent"], "properties": { "type": { "const": "agent:connection-changed" }, "connected": { "type": "boolean" }, "agent": { "$ref": "types.schema.json#/definitions/AgentId" } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "sessionId", "toolCall"], "properties": { "type": { "const": "agent:tool-call" }, "sessionId": { "type": "string" }, "toolCall": { "$ref": "types.schema.json#/definitions/ToolCall" } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "sessionId", "message"], "properties": { "type": { "const": "chat:message" }, "sessionId": { "type": "string" }, "message": { "$ref": "types.schema.json#/definitions/ChatMessage" } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "tasks"], "properties": { "type": { "const": "tasks:changed" }, "tasks": { "type": "array", "items": { "$ref": "types.schema.json#/definitions/Task" } } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "path"], "properties": { "type": { "const": "editor:opened" }, "path": { "type": "string" } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "path", "edits"], "properties": { "type": { "const": "editor:edited" }, "path": { "type": "string" }, "edits": { "type": "array", "items": { "$ref": "types.schema.json#/definitions/TextEdit" } } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "diagnostics"], "properties": { "type": { "const": "diagnostics:changed" }, "diagnostics": { "type": "array", "items": { "$ref": "types.schema.json#/definitions/Diagnostic" } } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "path"], "properties": { "type": { "const": "knowledge:changed" }, "path": { "type": "string" } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "instanceId", "panelId"], "properties": { "type": { "const": "panel:opened" }, "instanceId": { "type": "string" }, "panelId": { "type": "string" }, "area": { "type": "string", "enum": ["center", "left", "right", "bottom"] } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "instanceId"], "properties": { "type": { "const": "panel:closed" }, "instanceId": { "type": "string" } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "target"], "properties": { "type": { "const": "preview:registered" }, "target": { "$ref": "types.schema.json#/definitions/PreviewTarget" } } },
    { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "preview:refresh-requested" } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "formation"], "properties": { "type": { "const": "formation:updated" }, "formation": { "$ref": "types.schema.json#/definitions/Formation" } } },
    { "type": "object", "additionalProperties": false, "required": ["type", "key", "value"], "properties": { "type": { "const": "state:changed" }, "key": { "$ref": "types.schema.json#/definitions/StateKey" }, "value": true } },
    { "type": "object", "additionalProperties": false, "required": ["type", "plugins"], "properties": { "type": { "const": "plugins:changed" }, "plugins": { "type": "array", "items": { "$ref": "types.schema.json#/definitions/PluginRef" } } } }
  ]
}
