{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://polypore.dev/schemas/types.schema.json",
  "title": "PolyporeTypes",
  "definitions": {
    "AgentId": { "type": "string" },
    "Position": { "type": "object", "additionalProperties": false, "required": ["line", "column"], "properties": { "line": { "type": "number" }, "column": { "type": "number" } } },
    "Range": { "type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": { "start": { "$ref": "#/definitions/Position" }, "end": { "$ref": "#/definitions/Position" } } },
    "TextEdit": { "type": "object", "additionalProperties": false, "required": ["range", "newText"], "properties": { "range": { "$ref": "#/definitions/Range" }, "newText": { "type": "string" } } },
    "Capability": { "type": "string", "enum": ["memory-dir", "slash-commands", "tool-servers", "compaction", "phase-reporting", "permission-flow", "subagent-spawn", "streaming", "tool-use"] },
    "PanelCategory": { "type": "string", "enum": ["editor", "agent", "verify", "knowledge", "runtime", "other"] },
    "HostPermission": {
      "type": "string",
      "enum": ["state.read", "editor.read", "editor.write", "editor.decorate", "knowledge.read", "knowledge.write", "tasks.read", "tasks.write", "diagnostics.read", "verify.read", "verify.run", "iterate.run", "chat.read", "chat.send", "chat.context", "agent.control", "history.read", "history.fork", "history.revert", "workspace.read", "workspace.write", "preview.read", "preview.register", "preview.refresh", "terminal.spawn", "terminal.stop", "terminal.write", "terminal.read", "fs.write", "ui.notify", "ui.confirm", "ui.openExternal", "ui.statusBar", "ui.input", "plugins.read", "plugins.write", "secrets.list", "secrets.use", "mcp.invoke", "skills.read", "skills.write", "skills.delete", "skills.invoke", "debug.read", "debug.control", "storage.read", "storage.write", "git.read", "git.write", "bus.publish", "http.fetch", "clipboard.read", "clipboard.write"]
    },
    "AgentImpl": { "type": "object", "additionalProperties": false, "required": ["agent", "description", "available"], "properties": { "agent": { "$ref": "#/definitions/AgentId" }, "description": { "type": "string" }, "available": { "type": "boolean" }, "docsUrl": { "type": "string" } } },
    "AgentCapabilityMap": { "type": "object", "additionalProperties": { "anyOf": [{ "$ref": "#/definitions/AgentImpl" }, { "type": "null" }] } },
    "PanelManualContent": { "type": "object", "additionalProperties": false, "required": ["summary", "tips"], "properties": { "summary": { "type": "string" }, "tips": { "type": "array", "items": { "type": "string" } }, "externalDocsUrl": { "type": "string" } } },
    "PanelSettingSchema": { "type": "object", "additionalProperties": true, "required": ["fields"], "properties": { "fields": { "type": "array" } } },
    "WorkspaceName": { "type": "string" },
    "Workspace": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "name", "dockview", "panelInstances"], "properties": { "schemaVersion": { "const": 1 }, "name": { "$ref": "#/definitions/WorkspaceName" }, "dockview": { "type": "object", "additionalProperties": true }, "panelInstances": { "type": "object", "additionalProperties": true } } },
    "FileNode": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["kind", "name", "path"], "properties": { "kind": { "const": "file" }, "name": { "type": "string" }, "path": { "type": "string" }, "subtitle": { "type": "string" } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "name", "path", "children"], "properties": { "kind": { "const": "folder" }, "name": { "type": "string" }, "path": { "type": "string" }, "children": { "type": "array", "items": { "$ref": "#/definitions/FileNode" } } } }] },
    "DiagnosticSeverity": { "type": "string", "enum": ["error", "warn", "info", "hint"] },
    "Diagnostic": { "type": "object", "additionalProperties": false, "required": ["id", "severity", "source", "file", "range", "message"], "properties": { "id": { "type": "string" }, "severity": { "$ref": "#/definitions/DiagnosticSeverity" }, "source": { "type": "string" }, "file": { "type": "string" }, "range": { "$ref": "#/definitions/Range" }, "message": { "type": "string" }, "code": { "anyOf": [{ "type": "string" }, { "type": "number" }] } } },
    "DiagnosticFilter": { "type": "object", "additionalProperties": false, "properties": { "severity": { "$ref": "#/definitions/DiagnosticSeverity" }, "file": { "type": "string" }, "source": { "type": "string" } } },
    "Task": { "type": "object", "additionalProperties": false, "required": ["id", "label", "done", "createdAt", "createdBy"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "done": { "type": "boolean" }, "parentId": { "type": "string" }, "panelHint": { "type": "string" }, "createdAt": { "type": "number" }, "createdBy": { "type": "string", "enum": ["user", "agent"] } } },
    "VerifyStatus": { "type": "string", "enum": ["ok", "fail", "pending"] },
    "VerifyRun": { "type": "object", "additionalProperties": false, "required": ["id", "label", "command", "required", "status", "exitCode", "ranAt", "output", "durationMs"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "command": { "type": "string" }, "cwd": { "type": "string" }, "required": { "type": "boolean" }, "status": { "$ref": "#/definitions/VerifyStatus" }, "exitCode": { "anyOf": [{ "type": "number" }, { "type": "null" }] }, "ranAt": { "anyOf": [{ "type": "number" }, { "type": "null" }] }, "output": { "type": "string" }, "durationMs": { "anyOf": [{ "type": "number" }, { "type": "null" }] } } },
    "VerifyConfig": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "commands"], "properties": { "schemaVersion": { "const": 1 }, "commands": { "type": "array", "items": { "type": "object", "additionalProperties": true } } } },
    "HistoryEventKind": { "type": "string", "enum": ["tool-call", "file-write", "file-edit", "message", "phase-change", "snapshot"] },
    "HistoryEvent": { "type": "object", "additionalProperties": false, "required": ["id", "ts", "taskId", "source", "kind", "affectedFiles", "summary"], "properties": { "id": { "type": "string" }, "ts": { "type": "number" }, "taskId": { "type": "string" }, "source": { "type": "string", "enum": ["agent", "human"] }, "kind": { "$ref": "#/definitions/HistoryEventKind" }, "agentId": { "$ref": "#/definitions/AgentId" }, "toolName": { "type": "string" }, "phase": { "type": "string" }, "affectedFiles": { "type": "array", "items": { "type": "string" } }, "summary": { "type": "string" }, "payload": { "type": "object", "additionalProperties": true }, "snapshotId": { "type": "number" }, "worktreeId": { "type": "string" }, "snapshotCommit": { "type": "string" } } },
    "HistoryFilter": { "type": "object", "additionalProperties": false, "properties": { "source": { "type": "string", "enum": ["agent", "human"] }, "kind": { "$ref": "#/definitions/HistoryEventKind" }, "toolName": { "type": "string" }, "file": { "type": "string" }, "since": { "type": "number" }, "until": { "type": "number" } } },
    "WorktreeRef": { "type": "object", "additionalProperties": false, "required": ["id", "path", "branch", "forkedFromEventId"], "properties": { "id": { "type": "string" }, "path": { "type": "string" }, "branch": { "type": "string" }, "forkedFromEventId": { "type": "string" } } },
    "KnowledgeNode": { "type": "object", "additionalProperties": true, "required": ["kind", "path"], "properties": { "kind": { "type": "string", "enum": ["doc", "folder"] }, "path": { "type": "string" } } },
    "Handoff": { "type": "object", "additionalProperties": false, "required": ["summary", "nextSteps", "context"], "properties": { "summary": { "type": "string" }, "nextSteps": { "type": "array", "items": { "type": "string" } }, "context": { "type": "array", "items": { "type": "string" } } } },
    "ChatMessage": { "type": "object", "additionalProperties": false, "required": ["id", "sessionId", "by", "ts", "text"], "properties": { "id": { "type": "string" }, "sessionId": { "type": "string" }, "by": { "type": "string", "enum": ["user", "agent", "tool"] }, "ts": { "type": "number" }, "text": { "type": "string" }, "toolCallId": { "type": "string" } } },
    "ToolCall": { "type": "object", "additionalProperties": false, "required": ["id", "sessionId", "agentId", "toolName", "summary", "status", "ts"], "properties": { "id": { "type": "string" }, "sessionId": { "type": "string" }, "agentId": { "$ref": "#/definitions/AgentId" }, "toolName": { "type": "string" }, "summary": { "type": "string" }, "status": { "type": "string", "enum": ["ok", "live", "fail"] }, "ts": { "type": "number" }, "historyEventId": { "type": "string" } } },
    "ChatSession": { "type": "object", "additionalProperties": false, "required": ["id", "agent", "title", "createdAt"], "properties": { "id": { "type": "string" }, "agent": { "$ref": "#/definitions/AgentId" }, "title": { "type": "string" }, "createdAt": { "type": "number" }, "worktreeId": { "type": "string" } } },
    "WorkflowNodeStatus": { "type": "string", "enum": ["pending", "running", "done", "failed", "paused"] },
    "WorkflowNode": { "type": "object", "additionalProperties": true, "required": ["id", "label", "level", "status"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "level": { "type": "string", "enum": ["phase", "sub"] }, "status": { "$ref": "#/definitions/WorkflowNodeStatus" } } },
    "WorkflowEdge": { "type": "object", "additionalProperties": false, "required": ["id", "source", "target"], "properties": { "id": { "type": "string" }, "source": { "type": "string" }, "target": { "type": "string" } } },
    "WorkflowGraph": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "taskId", "title", "enabled", "nodes", "edges"], "properties": { "schemaVersion": { "const": 1 }, "taskId": { "type": "string" }, "title": { "type": "string" }, "enabled": { "type": "boolean" }, "nodes": { "type": "array", "items": { "$ref": "#/definitions/WorkflowNode" } }, "edges": { "type": "array", "items": { "$ref": "#/definitions/WorkflowEdge" } } } },
    "PreviewKind": { "type": "string", "enum": ["site", "desktop", "mobile", "cli", "game", "test"] },
    "PreviewTarget": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "label", "command", "target", "registeredAt"], "properties": { "id": { "type": "string" }, "kind": { "$ref": "#/definitions/PreviewKind" }, "label": { "type": "string" }, "command": { "type": "string" }, "cwd": { "type": "string" }, "target": { "type": "string" }, "registeredAt": { "type": "number" }, "agentId": { "$ref": "#/definitions/AgentId" } } },
    "TerminalRef": { "type": "object", "additionalProperties": false, "required": ["id", "pid", "shell", "cwd"], "properties": { "id": { "type": "string" }, "pid": { "type": "number" }, "shell": { "type": "string" }, "cwd": { "type": "string" } } },
    "FormationRole": { "type": "string" },
    "FormationNode": { "type": "object", "additionalProperties": true, "required": ["id", "role", "detail", "root", "status"], "properties": { "id": { "type": "string" }, "role": { "$ref": "#/definitions/FormationRole" }, "detail": { "type": "string" }, "root": { "type": "boolean" }, "status": { "type": "string", "enum": ["idle", "running", "waiting", "done", "failed"] } } },
    "Formation": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "taskId", "nodes", "edges"], "properties": { "schemaVersion": { "const": 1 }, "taskId": { "type": "string" }, "nodes": { "type": "array", "items": { "$ref": "#/definitions/FormationNode" } }, "edges": { "type": "array", "items": { "$ref": "#/definitions/WorkflowEdge" } } } },
    "SkillScope": { "type": "string", "enum": ["project", "user", "builtin"] },
    "SkillRef": { "type": "object", "additionalProperties": true, "required": ["id", "name", "scope", "summary", "path", "updatedAt"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "scope": { "$ref": "#/definitions/SkillScope" }, "summary": { "type": "string" }, "path": { "type": "string" }, "updatedAt": { "type": "number" } } },
    "Skill": { "allOf": [{ "$ref": "#/definitions/SkillRef" }, { "type": "object", "additionalProperties": true, "required": ["body", "createdAt"], "properties": { "body": { "type": "string" }, "createdAt": { "type": "number" } } }] },
    "SecretScope": { "type": "string", "enum": ["user", "project"] },
    "SecretRef": { "type": "object", "additionalProperties": false, "required": ["id", "scope", "configured"], "properties": { "id": { "type": "string" }, "scope": { "$ref": "#/definitions/SecretScope" }, "service": { "type": "string" }, "hint": { "type": "string" }, "configured": { "type": "boolean" }, "lastUsedAt": { "type": "number" } } },
    "SecretInvoke": { "type": "object", "additionalProperties": true, "required": ["id", "request"], "properties": { "id": { "type": "string" }, "request": { "type": "object", "additionalProperties": true } } },
    "SecretInvokeResult": { "type": "object", "additionalProperties": false, "required": ["status", "headers", "body"], "properties": { "status": { "type": "number" }, "headers": { "type": "object", "additionalProperties": { "type": "string" } }, "body": { "type": "string" } } },
    "McpInvoke": { "type": "object", "additionalProperties": false, "required": ["server", "method", "args"], "properties": { "server": { "type": "string" }, "method": { "type": "string" }, "args": { "type": "object", "additionalProperties": true }, "authRef": { "type": "string" }, "timeoutMs": { "type": "number" } } },
    "PluginRef": { "type": "object", "additionalProperties": true, "required": ["id", "version", "scope", "enabled", "installedAt"], "properties": { "id": { "type": "string" }, "version": { "type": "string" }, "scope": { "type": "string", "enum": ["project", "user", "builtin"] }, "enabled": { "type": "boolean" }, "installedAt": { "type": "number" } } },
    "PluginStaging": { "type": "object", "additionalProperties": true, "required": ["stagingPath", "source", "fileTree", "candidates"], "properties": { "stagingPath": { "type": "string" } } },
    "OpenPanelOpts": { "type": "object", "additionalProperties": false, "properties": { "area": { "type": "string", "enum": ["center", "left", "right", "bottom"] }, "group": { "type": "string" }, "active": { "type": "boolean" }, "props": { "type": "object", "additionalProperties": true } } },
    "StateKey": { "type": "string", "enum": ["activeAgent", "agentConnected", "workspace", "activePanel", "agentPanels", "branch", "contextUsedPct", "context", "permissionMode", "loopCycle", "preview", "formation", "tasks", "diagnostics", "verifyRuns"] }
  },
  "type": "object",
  "additionalProperties": true
}
