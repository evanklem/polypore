{
  "name": "polypore",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "dockview": "^6.3.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0"
  },
  "scripts": {
    "codegen": "node scripts/codegen-ts.mjs",
    "prebuild": "npm run codegen",
    "start": "vite --host 127.0.0.1 --port 1420",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "dev:tauri": "node scripts/tauri-before-dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "app": "tauri dev",
    "app:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "node packages/mcp-server/src/server.mjs",
    "mcp:smoke": "node packages/mcp-server/src/server.mjs < scripts/mcp-smoke.jsonl",
    "mcp:pipeline-smoke": "node scripts/mcp-pipeline-smoke.mjs",
    "mcp:secret-broker-smoke": "node scripts/mcp-secret-broker-smoke.mjs",
    "mcp:host-broker-smoke": "node scripts/mcp-host-broker-smoke.mjs",
    "lint": "npm run typecheck",
    "typecheck": "npm run codegen && tsc --noEmit",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "ajv": "^8.20.0",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.4.5",
    "vite": "^6.4.2",
    "vitest": "^4.1.7"
  }
}
